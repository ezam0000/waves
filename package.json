    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "vitest": "5.0.4"
  }
}
